generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ParticipantType {
  RETAILER
  SUPPLIER
}

enum ParticipantStatus {
  DRAFT
  DOCUMENTS_SUBMITTED
  VERIFIED
  PILOT
  LIVE
  ACTIVE
  REJECTED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum SettlementStatus {
  INITIATED
  PENDING_PROCESSING
  PROCESSING
  PROCESSING_COMPLETE
  AWAITING_RECONCILIATION
  COMPLETED
  PROCESSING_FAILED
  FAILED
}

enum TransactionStatus {
  INITIATED
  PROCESSING
  PENDING
  COMPLETED
  FAILED
}

model MpesaRequestLog {
  id        String   @id @default(cuid())
  endpoint  String
  method    String
  path      String
  requestBody Json
  queryParams Json?
  pathParams  Json?
  createdAt DateTime @default(now())

  @@map("mpesa_request_logs")
}

model MpesaTransaction {
  id                            String           @id @default(cuid())
  merchantRequestId             String?
  checkoutRequestId             String?          @unique
  callbackToken                 String?          @unique
  callbackConsumed              Boolean          @default(false)
  amount                        Float?
  currency                      String?          @default("KES")
  status                        TransactionStatus @default(PENDING)
  receiptNumber                 String?
  resultCode                    Int?
  resultDescription            String?
  customerMessage               String?
  businessShortCode             String?
  accountReference              String?
  phoneNumber                   String?
  requestFingerprint            String?
  requestBody                   Json?
  callbackBody                  Json?
  validationFailureReason       String?
  processingLogs                Json?
  pushFailureReason             String?
  replayAttempts                Int              @default(0)
  lastReplayAttemptAt           DateTime?
  callbackReceivedAt            DateTime?
  settlementId                  String?
  merchantTransactionReference  String?
  gatewayPayloadJson            Json?
  settlementNotificationStatus  String?          @default("PENDING")
  settlementNotificationAttempts Int             @default(0)
  settlementNotificationSentAt  DateTime?
  settlementNotificationLastAttemptAt DateTime?
  settlementNotificationError   String?
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  @@map("mpesa_transactions")
}

enum TransactionType {
  SALE
  ADJUSTMENT
  REFUND
  DEDUCTION
}

model Hello {
  id   Int    @id @default(autoincrement())
  text String
}

model OnboardingParticipant {
  id                    String             @id @default(cuid())
  participantType       ParticipantType
  businessName          String
  registrationNumber    String?
  kraPin                String?
  businessType          String?
  industry              String?
  physicalAddress       String?
  contactName           String?
  email                 String?
  phoneNumber           String?
  settlementMethod      String?
  settlementAccount     String?
  posSystem             String?
  webhookUrl            String?
  settlementPreference  String?
  payment               Json?
  status                ParticipantStatus  @default(DRAFT)
  integrations          Integration[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model Integration {
  id              String               @id @default(cuid())
  participantId   String
  participant     OnboardingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  merchantId      String               @unique
  apiKey          String?
  apiSecret       String?
  apiKeyHash      String
  apiSecretHash   String
  environment     String               @default("production")
  webhookUrl      String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model User {
  id                  String   @id @default(cuid())
  username            String   @unique
  email               String   @unique
  passwordHash        String
  role                UserRole @default(USER)
  isActive            Boolean  @default(true)
  refreshTokenVersion Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model OnboardingMessage {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

model SettlementSession {
  id            String   @id @default(cuid())
  businessId    String
  integrationId String
  token         String   @unique
  expiresAt     DateTime
  lastUsedAt    DateTime?
  status        SettlementSessionStatus @default(ACTIVE)
  createdAt     DateTime @default(now())

  @@index([businessId])
  @@index([integrationId])
  @@index([expiresAt])
}

enum SettlementSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Settlement {
  id                    String              @id @default(cuid())
  businessId            String
  integrationId         String
  amount                Decimal             @db.Decimal(18, 2)
  currency              String
  settlementMethod      String
  reference             String             @unique
  merchantTransactionReference String
  paymentPayload        Json?
  status                SettlementStatus    @default(INITIATED)
  description           String?
  bankReference         String?
  bankTransactionId     String?
  reconciliationStatus  String?
  failureReason         String?
  metadata              Json?
  paymentSnapshot       Json?
  transactions          Transaction[]
  b2bPayoutAttempts     B2BPayoutAttempt[]  @relation("B2BPayoutAttempts")
  createdAt             DateTime            @default(now())
  processedAt           DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  reconciliedAt         DateTime?

  @@unique([businessId, merchantTransactionReference])
  @@index([businessId])
  @@index([integrationId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id                  String            @id @default(cuid())
  settlementId        String
  settlement          Settlement        @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  itemId              String
  supplierMerchantId  String?
  type                TransactionType
  amount              Decimal           @db.Decimal(18, 2)
  quantity            Decimal?          @db.Decimal(12, 2)
  unitPrice           Decimal?          @db.Decimal(12, 2)
  description         String?
  status              TransactionStatus @default(INITIATED)
  createdAt           DateTime          @default(now())
  completedAt         DateTime?

  @@index([settlementId])
  @@index([status])
}

enum B2BPayoutStatus {
  PENDING
  SUBMITTED
  COMPLETED
  FAILED
  RETRYING
}

model B2BPayoutAttempt {
  id                          String              @id @default(cuid())
  settlementId                String
  settlement                  Settlement          @relation("B2BPayoutAttempts", fields: [settlementId], references: [id], onDelete: Cascade)
  merchantTransactionReference String
  payoutReference             String              @unique
  idempotencyKey              String              @unique
  party                       ParticipantType
  amount                      Decimal             @db.Decimal(18, 2)
  recipientMerchantId         String?
  recipientType               String              @default("MPESA")
  recipientPhone              String?
  status                      B2BPayoutStatus     @default(PENDING)
  gatewayResponseCode         String?
  gatewayResponseDescription  String?
  gatewayResponse             Json?
  callbackIdentifier          String?
  callbackReceived            Boolean             @default(false)
  callbackReceivedAt          DateTime?
  attemptCount                Int                 @default(1)
  lastAttemptAt               DateTime            @default(now())
  nextRetryAt                 DateTime?
  failureReason               String?
  metadata                    Json?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  @@unique([settlementId, party, recipientMerchantId])
  @@index([settlementId])
  @@index([merchantTransactionReference])
  @@index([status])
  @@index([idempotencyKey])
  @@index([nextRetryAt])
  @@index([createdAt])

  @@map("b2b_payout_attempts")
}

model B2BPayoutRetryPolicy {
  id            String    @id @default(cuid())
  maxRetries    Int       @default(5)
  initialDelayMs Int      @default(60000)
  maxDelayMs    Int       @default(3600000)
  backoffMultiplier Float @default(2.0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("b2b_payout_retry_policies")
}

